APP_NAME=Secure File Sharing with Encryption
DEBUG=true
DATABASE_URL=sqlite:///./secure_file_sharing.db
SECRET_KEY=change-me-in-production
RESET_DATABASE_ON_STARTUP=false
CORS_ORIGINS=["http://localhost:5173"]

# Storage Backend: "s3" (Backblaze B2 / AWS S3 / Cloudflare R2) or "local" (ephemeral disk)
STORAGE_BACKEND=s3
LOCAL_BLOB_PATH=./storage/blobs

# Object Storage Configuration (Backblaze B2 S3-Compatible API)
S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
S3_ACCESS_KEY_ID=<your_backblaze_key_id>
S3_SECRET_ACCESS_KEY=<your_backblaze_application_key>
S3_BUCKET_NAME=sfs-blobs-chandangowdac
S3_REGION=us-east-005
